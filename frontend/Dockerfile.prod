# syntax=docker/dockerfile:1
# Frontend (React + Vite, PWA) de EnerCheck para producción. Lo construye el pipeline.
# Contexto de build: frontend/.   docker build -f frontend/Dockerfile.prod -t enercheck-frontend frontend
# Sirve la SPA y hace de proxy de /api/ y /uploads/ hacia enercheck_backend (nginx.prod.conf), con los
# encabezados de seguridad de snippets/seguridad.conf. Delante solo está Traefik (Dokploy), que termina TLS.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . ./
# La API va en el mismo host: el cliente usa la ruta relativa /api/v1.
ENV VITE_API_URL=/api/v1
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY snippets/ /etc/nginx/snippets/
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/salud || exit 1
