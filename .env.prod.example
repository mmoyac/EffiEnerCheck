# EnerCheck — variables de PRODUCCIÓN. Se pegan en Dokploy (proyecto enercheck → Environment), que las
# escribe como .env junto al compose. Reemplazar TODOS los CAMBIAR_* y nunca versionar el resultado.
# Los secretos generados (POSTGRES_PASSWORD, SECRET_KEY) se generan en el servidor (DEPLOY.md), no en el chat.
# El backend se niega a arrancar si SECRET_KEY queda con el valor de ejemplo, si falta GEMINI_API_KEY
# o si alguna cuenta conserva la clave pública del seed (app/arranque.py). Generar secretos con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Despliegue (los lee docker compose) ---
DOCKER_USERNAME=mmoyac
# Vacío en operación normal: se usan las imágenes del commit que desplegó el pipeline.
# Rollback: el SHA completo de un commit anterior ya publicado, y Deploy en Dokploy.
TAG=

# --- PostgreSQL (contenedor enercheck_db) ---
# Solo se usa al crear el volumen: cambiarla después aquí no cambia la base.
POSTGRES_PASSWORD=CAMBIAR_postgres

# --- Seguridad ---
SECRET_KEY=CAMBIAR_secret_key_de_al_menos_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
# Subred de dokploy-network (de donde llegan los nginx del portal y la landing) en la que se confía
# para X-Forwarded-* (nunca *). Debe coincidir con set_real_ip_from de frontend/ y landing/nginx.prod.conf:
#   docker network inspect dokploy-network --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
FORWARDED_ALLOW_IPS=10.0.1.0/24

# --- Super admin inicial (se crea una sola vez, si no hay ninguno; cambiar la clave aquí no la reescribe) ---
# Usar un correo distinto al de tu cuenta de comunero de la planilla (p. ej. un alias +admin).
SUPERADMIN_EMAIL=CAMBIAR_correo_superadmin
SUPERADMIN_NOMBRE=Marcelo Moya
# Al menos 12 caracteres.
SUPERADMIN_PASSWORD=CAMBIAR_superadmin

# --- OCR de boletas (Google Gemini Vision) ---
# Recomendado: una clave EXCLUSIVA de producción (https://aistudio.google.com/apikey → Create API key),
# distinta de la de desarrollo, para ver su consumo aparte y revocar una sin afectar a la otra.
# Se cambia en el Environment de Dokploy + Deploy, sin tocar el código. Ver DEPLOY.md §3.
GEMINI_API_KEY=CAMBIAR_gemini_api_key

# --- Correo de invitaciones y recuperación de clave (Resend; ver DEPLOY.md §3.1) ---
# Vacío = no se envían correos: las invitaciones se reenvían por WhatsApp desde Usuarios.
RESEND_API_KEY=
EMAIL_REMITENTE=no-responder@comunidadsantalaura.cl
# Portal al que apuntan los enlaces de usuarios sin condominio (super admin) o sin portal_url
PORTAL_URL_POR_DEFECTO=https://portal.comunidadsantalaura.cl

# --- Landing pública (app landing/) ---
# RUT del condominio cuyo sitio se muestra si el dominio de la petición no está registrado en ningún
# condominio (los dominios se asignan en Condominios). Vacío = 404 para dominios desconocidos.
SITIO_POR_DEFECTO=
