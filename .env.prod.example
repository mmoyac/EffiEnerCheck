# EnerCheck — .env de PRODUCCIÓN (VPS: /root/docker/enercheck/.env, permisos 600).
# Copiar este archivo, reemplazar TODOS los CAMBIAR_* y nunca versionar el resultado.
# El backend se niega a arrancar si SECRET_KEY queda con el valor de ejemplo, si falta GEMINI_API_KEY
# o si alguna cuenta conserva la clave pública del seed (app/arranque.py). Generar secretos con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Despliegue (los lee docker compose) ---
DOCKER_USERNAME=mmoyac
# Tag de las imágenes: latest en operación normal; un SHA de commit para hacer rollback.
TAG=latest

# --- PostgreSQL (contenedor enercheck_db) ---
# Solo se usa al crear el volumen: cambiarla después aquí no cambia la base.
POSTGRES_PASSWORD=CAMBIAR_postgres

# --- Seguridad ---
SECRET_KEY=CAMBIAR_secret_key_de_al_menos_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
# Subred de general-net en la que se confía para X-Forwarded-* (nunca *). Se obtiene con:
#   docker network inspect general-net --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
FORWARDED_ALLOW_IPS=172.18.0.0/16

# --- Super admin inicial (se crea una sola vez, si no hay ninguno; cambiar la clave aquí no la reescribe) ---
# Usar un correo distinto al de tu cuenta de parcelero de la planilla (p. ej. un alias +admin).
SUPERADMIN_EMAIL=CAMBIAR_correo_superadmin
SUPERADMIN_NOMBRE=Marcelo Moya
# Al menos 12 caracteres.
SUPERADMIN_PASSWORD=CAMBIAR_superadmin

# --- OCR de boletas (Google Gemini Vision) ---
GEMINI_API_KEY=CAMBIAR_gemini_api_key

# --- Landing pública (app landing/) ---
# RUT del condominio cuyo sitio se muestra si el dominio de la petición no está registrado en ningún
# condominio (los dominios se asignan en Condominios). Vacío = 404 para dominios desconocidos.
SITIO_POR_DEFECTO=
