# syntax=docker/dockerfile:1
# Landing pública (React + Vite) para producción. Aplicación aparte del portal: imagen, contenedor y
# dominio propios. Lo construye el pipeline.
# Contexto de build: landing/.   docker build -f landing/Dockerfile.prod -t enercheck-landing landing
# Sirve los estáticos y hace de proxy solo de GET /api/v1/sitio y /uploads/condominios/ hacia
# enercheck_backend (nginx.prod.conf), con la CSP de snippets/seguridad.conf. Delante solo está Traefik.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY snippets/ /etc/nginx/snippets/
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/salud || exit 1
