// Use dbdiagram.io para visualizar este esquema profesional

// 1. ESTRUCTURA MULTI-CONDOMINIO (SaaS)
Table condominios {
  id integer [primary key]
  nombre varchar // "Condominio Las Camelias"
  rut_comunidad varchar [unique]
  direccion varchar
  plan_suscripcion varchar [note: 'basico, pro, premium']
  activo boolean [default: true]
  created_at timestamp
  // Parametrización comercial (la define el super_admin)
  portal_url varchar [note: 'URL pública del portal; destino de "Acceso propietarios"']
  logo_url varchar [note: '/uploads/condominios/<id>/logo-<uuid>.<ext>; PNG, JPEG o WEBP']
  color_primario varchar(7) [note: '#RRGGBB en mayúsculas; NULL = color por defecto']
}

// Productos y módulos contratados (catálogo en backend/app/core/modulos.py)
Table condominio_modulos {
  condominio_id integer [ref: > condominios.id]
  modulo varchar(20) [note: 'sitio, portal, energia, rifas; energia y rifas exigen portal']

  indexes {
    (condominio_id, modulo) [pk]
  }
}

// Dominios en que se publica la landing del condominio
Table condominio_dominios {
  dominio varchar(253) [primary key, note: 'minúsculas, sin www. ni puerto']
  condominio_id integer [ref: > condominios.id]
}

// 2. IDENTIDAD Y ACCESO (RBAC)
Table usuarios {
  id integer [primary key]
  nombre varchar
  email varchar [unique]
  password_hash varchar [note: 'NULL = invitación pendiente (no inicia sesión)']
  rol_id integer [ref: > roles.id]
  condominio_id integer [ref: > condominios.id, note: 'NULL para Super Admin']
  ultimo_login timestamp
  telefono varchar [note: '56XXXXXXXXX']
  clave_cambiada_en timestamptz [note: 'Los JWT emitidos antes dejan de valer']
}

Table enlaces_acceso {
  id integer [primary key]
  usuario_id integer [ref: > usuarios.id, note: 'ON DELETE CASCADE']
  tipo varchar [note: 'invitacion (7 días) | recuperacion (1 hora)']
  token_hash char(64) [unique, note: 'sha256 del token; el token solo viaja en el enlace']
  creado_en timestamptz
  expira_en timestamptz
  usado_en timestamptz [note: 'Un solo uso']
  anulado_en timestamptz [note: 'Lo anula un enlace nuevo del mismo tipo']
  indexes {
    (usuario_id, tipo)
  }
}

Table roles {
  id integer [primary key]
  nombre varchar // 'super_admin', 'admin_condominio', 'lector', 'parcelero'
  descripcion text
}

// 3. ASIGNACIÓN PARCELERO ↔ PARCELAS (M2M)
Table usuario_parcelas {
  usuario_id integer [ref: > usuarios.id]
  parcela_id integer [ref: > parcelas.id]

  indexes {
    (usuario_id, parcela_id) [pk]
  }
}

// 4. INFRAESTRUCTURA FÍSICA
Table parcelas {
  id integer [primary key]
  condominio_id integer [ref: > condominios.id]
  numero_parcela varchar
  propietario_nombre varchar
  activa boolean [default: true]
}

// 4. GESTIÓN ELÉCTRICA (MAESTRA)
Table boletas_maestras {
  id integer [primary key]
  condominio_id integer [ref: > condominios.id]
  periodo_mes date
  url_imagen_boleta varchar
  
  // Control de transparencia y flujo
  boleta_visible_usuarios boolean [default: false]
  estado varchar [note: 'borrador, validada, publicada']
  
  // Control de flujo de cierre de período
  lecturas_cerradas boolean [default: false, note: 'Lector certifica que todas las lecturas están ingresadas']
  liquidaciones_cerradas boolean [default: false, note: 'Admin cierra el período; nada se puede modificar después']

  // Totales para validación OCR
  total_kwh_compania float
  monto_neto_electricidad_consumida float [note: 'Base para cálculo Valor_kWh = (campo * 1.19) / total_kwh_compania']
  monto_total_emision integer
  monto_saldo_anterior integer
  creado_por integer [ref: > usuarios.id]
}

// 5. DETALLES Y LECTURAS
Table boleta_items_detalle {
  id integer [primary key]
  boleta_id integer [ref: > boletas_maestras.id]
  descripcion varchar // "Transporte", "Administración", etc.
  monto_neto_clp float
  tipo_calculo varchar // "fijo", "variable", "informativo"
}

Table lecturas_parcelas {
  id integer [primary key]
  parcela_id integer [ref: > parcelas.id]
  boleta_id integer [ref: > boletas_maestras.id]
  lectura_anterior float
  lectura_actual float
  kwh_consumidos float
  lector_id integer [ref: > usuarios.id]
  fecha_toma timestamp
}

// 6. LIQUIDACIONES FINALES
Table liquidaciones_parcelas {
  id integer [primary key]
  parcela_id integer [ref: > parcelas.id]
  boleta_id integer [ref: > boletas_maestras.id]
  
  monto_energia_kwh integer
  monto_prorrateo_variable integer
  monto_cuota_fija integer
  
  total_pagar_mes integer
  pagado boolean [default: false]
  fecha_pago timestamp
}

// 7. NAVEGACIÓN POR ROL
Table menus {
  id integer [primary key]
  label varchar          // "Dashboard", "Boletas", etc.
  path varchar           // "/dashboard", "/boletas"
  icon varchar           // nombre del ícono para el frontend
  orden integer
  parent_id integer [ref: > menus.id, note: 'Para submenús']
  activo boolean [default: true]
  modulo varchar(20) [note: 'NULL = núcleo; si no, módulo que debe tener el condominio']
}

Table menu_roles {
  menu_id integer [ref: > menus.id]
  rol_id integer [ref: > roles.id]

  indexes {
    (menu_id, rol_id) [pk]
  }
}

// 8. SEGURIDAD Y TRAZABILIDAD
Table auditoria_logs {
  id integer [primary key]
  condominio_id integer [ref: > condominios.id, note: 'NULL si es acción de Super Admin']
  usuario_id integer [ref: > usuarios.id]
  accion varchar // "LOGIN", "UPLOAD_BOLETA", "TOGGLE_VISIBILITY", "DELETE_USER"
  detalles jsonb [note: 'Guarda el estado anterior y nuevo del dato']
  ip_address varchar
  created_at timestamp [default: `now()`]
}


// --- Rifas solidarias: módulo aparte, no participa de las liquidaciones eléctricas ---

Table rifas {
  id integer [primary key]
  condominio_id integer [ref: > condominios.id]
  nombre varchar
  beneficiario varchar
  descripcion text
  premios "text[]" [note: 'En orden: el primero es el 1.º premio']
  datos_transferencia text
  precio_numero integer [note: 'CLP por número']
  cantidad_numeros integer [note: 'Números del 1 al N']
  estado varchar [default: 'abierta', note: 'abierta | cerrada']
  ultimo_folio integer [default: 0, note: 'Contador del folio de compras']
  creado_por_id integer [ref: > usuarios.id]
  created_at timestamp
  cerrada_at timestamp
}

Table compras_rifa {
  id integer [primary key]
  rifa_id integer [ref: > rifas.id]
  folio integer [note: 'Correlativo por rifa: R{rifa_id}-{folio:03d}']
  parcela_id integer [ref: > parcelas.id]
  usuario_id integer [ref: > usuarios.id, note: 'Cuenta que registró la compra']
  canal varchar [note: 'portal | porteria | administracion']
  comprador_nombre varchar [note: 'Texto libre: puede no ser residente']
  telefono varchar [note: '56XXXXXXXXX; destino del comprobante']
  numeros "integer[]" [note: 'Números originales; se conservan si se anula']
  monto integer [note: 'Congelado al comprar']
  medio_pago varchar [note: 'efectivo | transferencia | gasto_comun']
  pagada boolean [default: false]
  pagada_at timestamp
  pago_confirmado_por_id integer [ref: > usuarios.id]
  voucher_archivo varchar [note: 'En /app/privado/vouchers (no público)']
  voucher_mime varchar
  created_at timestamp
  anulada boolean [default: false]
  anulada_at timestamp
  anulada_por_id integer [ref: > usuarios.id]

  indexes {
    (rifa_id, folio) [unique]
  }
}

Table rifa_numeros {
  id integer [primary key]
  compra_id integer [ref: > compras_rifa.id]
  rifa_id integer [ref: > rifas.id]
  numero integer

  indexes {
    (rifa_id, numero) [unique, note: 'Un número vigente por rifa; se borra al anular']
  }
}

Table imputaciones_rifa {
  id integer [primary key]
  rifa_id integer [ref: > rifas.id]
  parcela_id integer [ref: > parcelas.id]
  cantidad_numeros integer
  monto integer [note: 'A cargar en el gasto común (Comunidad Feliz)']
  cargada boolean [default: false]
  cargada_at timestamp

  indexes {
    (rifa_id, parcela_id) [unique]
  }
}
